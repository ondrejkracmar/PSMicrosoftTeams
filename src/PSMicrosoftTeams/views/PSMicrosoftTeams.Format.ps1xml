							<TableColumnItem>
								<PropertyName>GivenName</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Surname</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>DisplayName</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>CompanyName</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>City</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
