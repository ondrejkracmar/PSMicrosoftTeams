<?xml version="1.0" encoding="utf-16"?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>PSMicrosoftEntraID.Users.User</Name>
			<ViewSelectedBy>
				<TypeName>PSMicrosoftEntraID.Users.User</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<AutoSize/>
				<TableHeaders>
					<TableColumnHeader>
            			<Width>16</Width>
          			</TableColumnHeader>
          			<TableColumnHeader>
            			<Width>16</Width>
					</TableColumnHeader>
					<TableColumnHeader>
