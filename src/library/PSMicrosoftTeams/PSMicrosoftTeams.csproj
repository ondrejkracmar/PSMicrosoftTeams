<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>PSMicrosoftTeams</AssemblyName>
		<RootNamespace>PSMicrosoftTeams</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputPath>../../PSMicrosoftTeams/bin/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<PublishTrimmed>false</PublishTrimmed>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier></RuntimeIdentifier>
		<!-- žádný RID = žádné runtimes -->
	</PropertyGroup>
    <ItemGroup>
	  <ProjectReference Include="..\..\..\..\PSMicrosoftEntraID\src\library\PSMicrosoftEntraID\PSMicrosoftEntraID.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(OS)' == 'Windows_NT'">
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.2.24" />
	</ItemGroup>

	<ItemGroup Condition="'$(OS)' != 'Windows_NT'">
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.2.12" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="PSMicrosoftEntraID">
	    <HintPath>..\..\..\..\PSMicrosoftEntraID\src\PSMicrosoftEntraID\bin\PSMicrosoftEntraID.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<Target Name="RemoveUnwantedOutputs" AfterTargets="Build">
		<RemoveDir Directories="$(OutputPath)ref" />
		<RemoveDir Directories="$(OutputPath)runtimes" />
	</Target>

</Project>
